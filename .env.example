OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
DATABASE_URL=mysql+pymysql://document_app:change_me@localhost:3306/document_automation?charset=utf8mb4

# IMAP inbox for stage 12. Use an app password, not your normal email password.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=documents@example.com
IMAP_PASSWORD=change_me
IMAP_MAILBOX=INBOX
EMAIL_ATTACHMENT_DIR=data/email_attachments
EMAIL_MAX_ATTACHMENT_BYTES=20971520
EMAIL_MAX_MESSAGES=25

# Google Sheets service-account integration (stage 13).
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_WORKSHEET=Invoices

# Gmail SMTP notifications (stage 14). If omitted, Gmail IMAP credentials from
# stage 12 are reused and notifications are sent back to the same account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=documents@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=documents@example.com
NOTIFICATION_EMAIL_TO=recipient@example.com

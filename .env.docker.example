# Copy to .env.docker and replace every change_me value.
MYSQL_PASSWORD=change_me_document_app
MYSQL_ROOT_PASSWORD=change_me_root
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_value

# Host ports avoid the existing local MySQL and occupied port 8000.
MYSQL_HOST_PORT=3307
API_PORT=8016
N8N_PORT=5678

# Optional Google Sheets settings inside the API container.
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Invoices
